[Unit]
Description=Data@Spark {{ item.name }} runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ item.source_checkout }}
ExecStart=/usr/bin/podman compose --project-name {{ item.compose_project_name }} --env-file .env -f runtime-compose.yml up --detach --build
ExecStop=/usr/bin/podman compose --project-name {{ item.compose_project_name }} --env-file .env -f runtime-compose.yml down
TimeoutStartSec=10min

[Install]
WantedBy=default.target

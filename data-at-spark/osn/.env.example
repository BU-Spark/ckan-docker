# OSN overlay — PLACEHOLDERS ONLY. Copy to data-at-spark/osn/.env (gitignored)
# and fill in from the values shared out-of-band (Slack DM / ColdFront).
# Never commit the filled-in file, and never paste keys into issues or PRs.

# Pod S3 endpoint, scheme included, no bucket in the path.
# Public docs show https://<pod>.osn.mghpcc.org and the legacy
# https://mghp.osn.xsede.org; use exactly what Mitchell/ColdFront gives.
OSN_ENDPOINT_URL=https://REPLACE-pod-host.example

# OSN publishes no region; Ceph RGW usually accepts us-east-1 for SigV4.
# UNVERIFIED until Phase 2 step 1 passes.
OSN_REGION=us-east-1

# PRIVATE bucket: the only bucket CKAN talks to. CKAN gets the read/write key.
OSN_PRIVATE_BUCKET=REPLACE-private-bucket
OSN_PRIVATE_RW_ACCESS_KEY_ID=REPLACE-me
OSN_PRIVATE_RW_SECRET_ACCESS_KEY=REPLACE-me

# Not used by CKAN or this overlay. Listed so Phase 2 checks have a name for
# them; keep them in the operator's shell only.
# OSN_PRIVATE_RO_ACCESS_KEY_ID=REPLACE-me
# OSN_PRIVATE_RO_SECRET_ACCESS_KEY=REPLACE-me
# OSN_PUBLIC_BUCKET=REPLACE-public-bucket

# Default Data@Spark plugin list (data-at-spark/.env.example) plus s3filestore.
DATA_AT_SPARK_CKAN_PLUGINS_WITH_S3FILESTORE="image_view text_view datatables_view datastore datapusher envvars spark s3filestore"

S3FILESTORE_SIGNED_URL_EXPIRY=60
